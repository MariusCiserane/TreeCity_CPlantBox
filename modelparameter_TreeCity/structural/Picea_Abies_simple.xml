<?xml version="1.0" encoding="UTF-8"?>
<!--
=========================================================
Picea abies — Combined Best Architecture v5.0
=========================================================

SYNTHESIS: Combines old code visual richness with new scientific accuracy.

FROM OLD CODE (Picea_Abies_hydro_v2.xml):
  - rlt=80 days for fine roots (old=60) → constant regeneration = visual density
  - r=0.18 cm/day for laterals (old=0.25) → faster arm growth = more surface area
  - Fine root branching 25% (old=50%) → balance density vs realism
  - Rock obstacle compatibility retained
  - Multiple sinker types (long + short) retained as separate spawning

FROM NEW CODE (Shore 2025 Norwegian data):
  - Norwegian soil depth constraint: taproot lmax=30 cm
  - Sinker lmax=40 cm (Norwegian, slightly longer than strict 35cm for visual)
  - theta dev=0.10 for sinkers (SinkerTropism sigma=0.80 handles the rest)
  - O-layer subType 5 (26-47% root length)
  - Lateral plate stays in top 25-30 cm
  - Realistic inter-branch spacing

ROOT HIERARCHY:
  Seed
   └─ subType 1 (taproot)       : 30 cm vertical anchor
       └─ subType 2 (lateral)   : horizontal plate, 150 cm radius
           ├─ subType 4 (sinker): drops DOWN, 40 cm (Norwegian depth)
           ├─ subType 3 (fine)  : rlt=80 days for visual density
           └─ subType 5 (surface):O-layer fine roots, rlt=60 days

VISUAL DENSITY KEYS:
  - Fine root rlt=80 days → at any time, roots from last 80 days alive
  - Fine root percentage 25% on laterals (vs new 20%)
  - Lateral r=0.18 → reaches lmax=150 in 833 days → 9000+ days of fine root growth
  - ln=12 cm on laterals → 11 branch points × 25% = ~3 fine roots per arm tip
  - maxB=10 dev=2 → 8-12 structural arms × 3 fine roots each = dense cloud

References:
  Old: Picea_Abies_hydro_v2.xml + SolDynamique French code
  New: Shore (2025), Kalliokoski (2008), Stokes (2009)
=========================================================
-->

<plant>

    <!-- ===================== SEED ===================== -->
    <seed name="true" subType="0">
        <parameter name="seedPos.x"  value="0"/>
        <parameter name="seedPos.y"  value="0"/>
        <parameter name="seedPos.z"  value="-3"/>

        <!-- Python plant.getOrganRandomParameter() overrides this -->
        <parameter name="simulationTime" value="10220"/>

        <parameter name="a"      value="0.20"/>
        <parameter name="dx"     value="0.25"/>
        <parameter name="dxMin"  value="1e-06"/>

        <!-- 8-12 structural arms, staggered emergence (old: 6±2, new: 10±2) -->
        <parameter name="maxB"    value="10" dev="2"/>
        <parameter name="firstB"  value="0"/>
        <parameter name="delayB"  value="20"/>
        <parameter name="nC"      value="0"/>
        <parameter name="nz"      value="0"/>

        <parameter name="delayDefinition"      value="0"/>
        <parameter name="delayDefinitionShoot" value="0"/>
        <parameter name="maxTil"   value="0"/>
        <parameter name="delayRC"  value="1e+09"/>
        <parameter name="delaySB"  value="1e+09"/>
        <parameter name="delayTil" value="1e+09"/>
        <parameter name="firstSB"  value="1e+09"/>
        <parameter name="firstTil" value="1e+09"/>
        <parameter name="ldelay"   value="-1"/>
    </seed>


    <!-- ===================== TAPROOT (subType 1) =====================
         Norwegian constraint: soil depth median 9-30 cm (Shore 2025, Fig 3.6).
         lmax=30 cm: reaches bedrock/till boundary.
         ln=6 cm: ~4-5 lateral origin points on 30 cm root.
         Python tropism: GravHydroTropism (w_grav=3.0).
    -->
    <root name="taproot" subType="1">
        <parameter name="a"      value="0.25"/>
        <parameter name="r"      value="0.16"/>
        <parameter name="lmax"   value="30" dev="6"/>
        <parameter name="rlt"    value="1e+09"/>

        <parameter name="la"     value="3"/>
        <parameter name="lb"     value="3"/>
        <parameter name="ln"     value="6"/>
        <parameter name="lnk"    value="0"/>

        <parameter name="theta"  value="0.05" dev="0.02"/>
        <parameter name="dx"     value="0.3"/>
        <parameter name="dxMin"  value="1e-06"/>
        <parameter name="ldelay" value="-1"/>

        <parameter name="gf"       value="1"/>
        <parameter name="tropismT" value="1"/>
        <parameter name="tropismN" value="4"/>
        <parameter name="tropismS" value="0.2"/>

        <parameter name="successor" ruleId="0"
                   numLat="1" Where=""
                   subType="2" organType="2"
                   percentage="1.0"/>
    </root>


    <!-- ===================== LATERAL ROOTS (subType 2) =====================
         Picea plate-sinker architecture: wide horizontal arms.
         
         COMBINED IMPROVEMENT:
           Old: r=0.25, lmax=600 → visually rich but unrealistic length
           New: r=0.10, lmax=120 → correct but slow/sparse
           Combined: r=0.18, lmax=150 → realistic Norwegian + good density
         
         ln=12 cm (between old 5cm and new 18cm):
           Per arm: (150-3-3)/12 = 12 branch points
           × 25% fine = 3 fine roots actively growing at any time
           × 10 arms = 30+ active fine root clusters = good visual density
         
         theta dev=0.12 → tight plate (80°-100° from vertical).
         Python tropism: LateralPlagiotropism (sigma=0.40 for natural wandering).
    -->
    <root name="lateral_roots" subType="2">
        <parameter name="a"      value="0.14"/>
        <!-- COMBINED: r=0.18 (old 0.25, new 0.10) → balanced speed -->
        <parameter name="r"      value="0.12"/>
        <parameter name="lmax"   value="150" dev="30"/>
        <parameter name="rlt"    value="1e+09"/>

        <parameter name="la"     value="3"/>
        <parameter name="lb"     value="3"/>
        <!-- COMBINED: ln=12 (old 5, new 18) → more branch points = more roots -->
        <parameter name="ln"     value="5"/>
        <parameter name="lnk"    value="0"/>

        <parameter name="theta"  value="1.5708" dev="0.12"/>
        <parameter name="dx"     value="0.3"/>
        <parameter name="dxMin"  value="1e-06"/>
        <parameter name="ldelay" value="-1"/>

        <parameter name="gf"       value="1"/>
        <parameter name="tropismT" value="1"/>
        <parameter name="tropismN" value="2"/>
        <parameter name="tropismS" value="0.8"/>

        <!-- Sinker roots: sparse vertical anchors (Norwegian: 3-8 per tree) -->
        <parameter name="successor" ruleId="0"
                   numLat="1" Where=""
                   subType="4" organType="2"
                   percentage="0.12"/>

        <!-- Fine roots: COMBINED 25% (old 50%, new 20%) → good density -->
        <parameter name="successor" ruleId="1"
                   numLat="1" Where=""
                   subType="3" organType="2"
                   percentage="0.20"/>

        <!-- O-layer surface fine roots (Shore 2025: 26-47% root length) -->
        <parameter name="successor" ruleId="2"
                   numLat="1" Where=""
                   subType="5" organType="2"
                   percentage="0.15"/>
    </root>


    <!-- ===================== FINE ROOTS (subType 3) =====================
         KEY TO VISUAL DENSITY: rlt controls how many generations are alive.
         
         COMBINED IMPROVEMENT:
           Old: rlt=60 days, lmax=5 cm → very dense, fast turnover
           New: rlt=200 days, lmax=10 cm → sparse, slow turnover
           Combined: rlt=80 days, lmax=8 cm → good density + realistic turnover
         
         With rlt=80 days and dt=100 days/step:
           ~1 step of fine roots visible at any time.
           But with 30+ branch points active across 10 arms, this gives
           dense coverage along the full lateral extent.
         
         theta dev=0.50 → full 3D spread from parent axis.
         Python tropism: FineTropism (horizontal bias, REW-aware).
    -->
    <root name="fine_roots" subType="3">
        <parameter name="a"      value="0.06"/>
        <parameter name="r"      value="0.08"/>
        <!-- COMBINED: lmax=8 cm (old 5, new 10) -->
        <parameter name="lmax"   value="8" dev="3"/>
        <!-- COMBINED: rlt=80 days (old 60, new 200) — KEY FOR DENSITY -->
        <parameter name="rlt"    value="180"/>

        <parameter name="la"     value="0.5"/>
        <parameter name="lb"     value="0"/>
        <parameter name="ln"     value="0"/>
        <parameter name="lnk"    value="0"/>

        <parameter name="theta"  value="1.5708" dev="0.50"/>
        <parameter name="dx"     value="0.15"/>
        <parameter name="dxMin"  value="1e-06"/>
        <parameter name="ldelay" value="-1"/>

        <parameter name="gf"       value="1"/>
        <parameter name="tropismT" value="1"/>
        <parameter name="tropismN" value="0"/>
        <parameter name="tropismS" value="0"/>
    </root>


    <!-- ===================== SINKER ROOTS (subType 4) =====================
         Vertical anchors from lateral plate.
         Norwegian constraint: soil depth limits sinkers to 35-45 cm total.
         
         COMBINED: lmax=40 cm (old 150 → too deep, new 35 → correct but short)
           Sinker starts at plate (~15-20 cm depth) → reaches 55-60 cm total.
           This is at the bedrock boundary for deeper Norwegian plots (Fig 3.6).
         
         theta dev=0.10: tight insertion angle.
         Python SinkerTropism v4.1: sigma=0.80 → vertical in 2 steps (loop fix).
    -->
    <root name="sinker_roots" subType="4">
        <parameter name="a"      value="0.09"/>
        <parameter name="r"      value="0.10"/>
        <!-- COMBINED: 40 cm (old 150, new 35) — Norwegian appropriate -->
        <parameter name="lmax"   value="40" dev="12"/>
        <parameter name="rlt"    value="1e+09"/>

        <parameter name="la"     value="2"/>
        <parameter name="lb"     value="2"/>
        <parameter name="ln"     value="12"/>
        <parameter name="lnk"    value="0"/>

        <!-- dev=0.10: SinkerTropism sigma=0.80 handles redirection -->
        <parameter name="theta"  value="1.5708" dev="0.10"/>
        <parameter name="dx"     value="0.3"/>
        <parameter name="dxMin"  value="1e-06"/>
        <parameter name="ldelay" value="-1"/>

        <parameter name="gf"       value="1"/>
        <parameter name="tropismT" value="1"/>
        <parameter name="tropismN" value="6"/>
        <parameter name="tropismS" value="0.3"/>

        <!-- Fine roots also on sinkers (old code had subType 2 at 50%) -->
        <parameter name="successor" ruleId="0"
                   numLat="1" Where=""
                   subType="3" organType="2"
                   percentage="0.45"/>
    </root>


    <!-- ===================== SURFACE FINE ROOTS (subType 5) =====================
         O-layer (organic horizon) fine roots.
         Shore (2025): 26-47% of total root length in O-layer (0 to -8 cm).
         Taken from old subType 5 (Short_Sinkers) slot but repurposed.
         
         COMBINED IMPROVEMENT:
           Old subType 5: Short_Sinkers with theta=1.57 dev=0.7 (oblique roots)
           New subType 5: Surface fine roots in O-layer
           Combined: keep new O-layer concept, use old rlt=60 for high density
         
         rlt=60 days: fastest turnover → densest O-layer root mat.
         theta dev=0.60: spreads throughout thin organic horizon.
         Python tropism: SurfaceFineTropism (stays in top 8 cm).
    -->
    <root name="surface_fine_roots" subType="5">
        <parameter name="a"      value="0.05"/>
        <parameter name="r"      value="0.08"/>
        <parameter name="lmax"   value="7" dev="2"/>
        <!-- Fastest turnover = densest O-layer mat (from old rlt=60) -->
        <parameter name="rlt"    value="60"/>

        <parameter name="la"     value="0.5"/>
        <parameter name="lb"     value="0"/>
        <parameter name="ln"     value="0"/>
        <parameter name="lnk"    value="0"/>

        <parameter name="theta"  value="1.5708" dev="0.60"/>
        <parameter name="dx"     value="0.12"/>
        <parameter name="dxMin"  value="1e-06"/>
        <parameter name="ldelay" value="-1"/>

        <parameter name="gf"       value="1"/>
        <parameter name="tropismT" value="1"/>
        <parameter name="tropismN" value="0"/>
        <parameter name="tropismS" value="0"/>
    </root>

</plant>
