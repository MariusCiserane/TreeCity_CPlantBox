        <parameter name="theta" value="0.8" dev="0.2"/>
        <!--Angle between root and parent root [rad]-->
                
        <parameter name="tropismN" value="6"/>
        <!--Number of trials of root tropism-->
        
        <parameter name="tropismS" value="4"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
                
        <parameter name="successor" ruleId="0" numLat="1" Where="" subType="2" organType="2" percentage="0.8"/>
        <!--Sub type of lateral -->
    </root>
</plant>