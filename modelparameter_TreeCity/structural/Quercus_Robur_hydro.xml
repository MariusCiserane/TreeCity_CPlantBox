<plant>
    <seed name="true" subType="0">
        <parameter name="delayDefinition" value="0"/>
        <!--method implemented to evaluate root lateral growth delay (0: distance based, 1: delay based defined by parent organ)-->
        
        <parameter name="delayDefinitionShoot" value="0"/>
        <!--method implemented to evaluate shoot lateral growth delay (0: distance based, 1: delay based defined by parent organ)-->

        <parameter name="maxTil" value="0"/>
        <!--Maximal number of tillers [1]-->

        <parameter name="a" value="0.025"/>
        <!--radius [cm]-->

        <parameter name="delayB" value="0"/>
        <!--Time delay between the basal roots [day]-->
        
        <parameter name="delayRC" value="1000"/>
        <!--Delay between the root crowns [day]-->
        
        <parameter name="delaySB" value="1000"/>
        <!--Time delay between the shoot borne roots [day]-->
        
        <parameter name="delayTil" value="1e+09"/>
        <!--Time delay between the tillers [day]-->
        
        <parameter name="dx" value="0.25"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        
        <parameter name="firstB" value="0"/>
        <!--Emergence of first basal root [day]-->
        
        <parameter name="firstSB" value="1000"/>
        <!--First emergence of a shoot borne root [day]-->
        
        <parameter name="firstTil" value="1e+09"/>
        <!--Emergence of first tiller [day]-->
        
        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->

        <parameter name="maxB" value="14"/>
        <!--Maximal number of basal roots [1]-->

        <parameter name="nC" value="0"/>
        <!--Maximal number of roots per root crown [1]-->

        <parameter name="nz" value="0"/>
        <!--Distance between the root crowns along the shoot [cm]-->
        
        <parameter name="seedPos.x" value="0"/>
        <!--X-Coordinate of seed position [cm]-->
        
        <parameter name="seedPos.y" value="0"/>
        <!--Y-Coordinate of seed position [cm]-->
        
        <parameter name="seedPos.z" value="-3"/>
        <!--Z-Coordinate of seed position [cm]-->
        
        <parameter name="simulationTime" value="1000"/> 
        <!--Recommended final simulation time  [day]-->
    </seed>

    <root name="Pivot" subType="1">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        
        <parameter name="tropismT" value="1"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        
        <parameter name="a" value="0.025"/>
        <!--radius [cm]-->

        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->

        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->

        <parameter name="la" value="10"/>
        <!--Apical zone [cm]-->

        <parameter name="lb" value="60"/>
        <!--Basal zone [cm]-->

        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->

        <parameter name="lmax" value="450"/> 
        <!--Maximal root length [cm]-->

        <parameter name="ln" value="2"/> 
        <!--Inter-lateral distance [cm]-->

        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        
        <parameter name="r" value="0.9" dev="0.3"/> 
        <!--Initial growth rate [cm day-1]-->

        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->

        <parameter name="theta" value="0"/>
        <!--Angle between root and parent root [rad]-->
                
        <parameter name="tropismN" value="8"/>
        <!--Number of trials of root tropism-->
        
        <parameter name="tropismS" value="0.2"/> 
        <!--Mean value of expected change of root tropism [1/cm]-->
               
        <parameter name="successor" ruleId="0" numLat="1" Where="" subType="2" organType="2" percentage="0.85"/>
        <!--Sub type of lateral -->

        <parameter name="successor" ruleId="1" numLat="14" Where="" subType="3" organType="2" percentage="0.005" />
        <!--Sub type of lateral -->
    </root>

    <root name="Surface_Contreforts" subType="4">
        
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        
        <parameter name="tropismT" value="0"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        
        <parameter name="a" value="0.025"/>
        <!--radius [cm]-->

        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->

        <parameter name="la" value="20"/>
        <!--Apical zone [cm]-->
        
        <parameter name="lb" value="5"/>
        <!--Basal zone [cm]-->

        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->

        <parameter name="lmax" value="950" dev="50"/> 
        <!--Maximal root length [cm]-->
        
        <parameter name="ln" value="15"/>
        <!--Maximal number of roots per root crown [1]-->

        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        
        <parameter name="r" value="0.9" dev="0.3"/>
        <!--Initial growth rate [cm day-1]--> 

        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->

        <parameter name="theta" value="1.45" dev="0"/> 
        <!--Angle between root and parent root [rad]-->
        
        <parameter name="tropismN" value="3"/>
        <!--Number of trials of root tropism-->
        
        <parameter name="tropismS" value="0.05"/> 
        <!--Mean value of expected change of root tropism [1/cm]-->        
        
        <parameter name="successor" ruleId="0" numLat="1" Where="" subType="5" organType="2" percentage="0.3"/>
        <!--Sub type of lateral -->
        
        <parameter name="successor" ruleId="1" numLat="1" Where="" subType="2" organType="2" percentage="0.7"/>
        <!--Sub type of lateral -->
    </root>

    <root name="Pivots_Secondaires" subType="3">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        
        <parameter name="tropismT" value="3"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        
        <parameter name="a" value="0.015"/>
        <!--radius [cm]-->

        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->

        <parameter name="la" value="10"/>
        <!--Apical zone [cm]-->
        
        <parameter name="lb" value="2"/>
        <!--Basal zone [cm]-->

        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->

        <parameter name="lmax" value="300"/>
        <!--Maximal root length [cm]-->

        <parameter name="ln" value="4"/>
        <!--Inter-lateral distance [cm]-->
        
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        
        <parameter name="r" value="0.6"/>
        <!--Initial growth rate [cm day-1]-->

        <parameter name="rlt" value="1e+09"/>
        <!--Root life time [day]-->
        
        <parameter name="theta" value="1.0" dev="0.44"/>
        <!--Angle between root and parent root [rad]-->
                
        <parameter name="tropismN" value="2" dev="2"/>
        <!--Number of trials of root tropism-->
        
        <parameter name="tropismS" value="0.6" dev="0.5"/>
        <!--Mean value of expected change of root tropism [1/cm]-->
                
        <parameter name="successor" ruleId="0" numLat="1" Where="" subType="2" organType="2" percentage="0.6"/>
        <!--Sub type of lateral -->
    </root>

    <root name="Fine_Roots" subType="2">
        
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        
        <parameter name="tropismT" value="3"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        
        <parameter name="a" value="0.00875"/> 
        <!--radius [cm]-->

        <parameter name="dx" value="0.2"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->
        
        <parameter name="la" value="0"/>
        <!--Apical zone [cm]-->
        
        <parameter name="lb" value="0"/>
        <!--Basal zone [cm]-->

        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->
        
        <parameter name="lmax" value="5" dev="0.5"/>
        <!--Maximal root length [cm]-->

        <parameter name="ln" value="0"/>
        <!--Inter-lateral distance [cm]-->
        
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        
        <parameter name="r" value="0.2"/>
        <!--Initial growth rate [cm day-1]-->

        <parameter name="rlt" value="250"/>
        <!--Root life time [day]-->

        <parameter name="theta" value="1.57"/>
        <!--Angle between root and parent root [rad]-->
        
        <parameter name="tropismN" value="1.5"/>
        <!--Number of trials of root tropism-->
        
        <parameter name="tropismS" value="0.4"/>
        <!--Mean value of expected change of root tropism [1/cm]-->       
    </root>

    <root name="Pivots_Peripheriques" subType="5">
        <parameter name="gf" value="1"/>
        <!--Growth function number [1]-->
        
        <parameter name="tropismT" value="3"/>
        <!--Type of root tropism (plagio = 0, gravi = 1, exo = 2, hydro, chemo = 3)-->
        
        <parameter name="a" value="0.015"/>
        <!--radius [cm]-->

        <parameter name="dx" value="0.5"/>
        <!--Axial resolution [cm] (maximal segment size)-->
        
        <parameter name="dxMin" value="1e-06"/>
        <!--Axial resolution [cm] (minimal segment size)-->

        <parameter name="la" value="10"/>
        <!--Apical zone [cm]-->
        
        <parameter name="lb" value="2"/>
        <!--Basal zone [cm]-->

        <parameter name="ldelay" value="-1"/>
        <!--Lateral emergence delay [day]-->

        <parameter name="lmax" value="50"/>
        <!--Maximal root length [cm]-->

        <parameter name="ln" value="4"/>
        <!--Inter-lateral distance [cm]-->
        
        <parameter name="lnk" value="0"/>
        <!--Slope of inter-lateral distances [1]-->
        
        <parameter name="r" value="0.6"/>
        <!--Initial growth rate [cm day-1]-->

        <parameter name="rlt" value="1e+09"/>
